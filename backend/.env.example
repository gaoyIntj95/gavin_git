# Copy to .env and replace every change-me value before startup.
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=carbon_ai
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=change-me-mysql-password
MYSQL_PASSWORD=change-me-mysql-password
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
MINIO_ENABLED=true
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=carbonadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_SECURE=false
MINIO_BUCKET=carbon-ai
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
REMOTE_LLM_ENABLED=false
REMOTE_LLM_API_KEY=
KG_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
